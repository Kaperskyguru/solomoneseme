# Copy to .env.local for dev. In production set these in Coolify (Environment Variables).
# Use a read-only / restricted key wherever the provider offers one.


# Where the snapshot JSON lives. Optional; default is <cwd>/data/snapshot.json
# (/app/data/snapshot.json in the Docker image). /app/data must be a persistent volume.
SNAPSHOT_FILE=

# Revenue providers
# Paystack/Paddle adapters exist but are unused: only needed if a product uses Paystack/Paddle
# (then add PAYSTACK_SECRET_KEY / PADDLE_API_KEY).
LEMONSQUEEZY_API_KEY=
ASYNCPAY_SECRET_KEY=
GUMROAD_ACCESS_TOKEN=

# Content
YOUTUBE_API_KEY=
BASE_ENDPOINT_URL=https://cms.masteringbackend.com/api
STRAPI_TOKEN=

# MasteringBackend academy API base (the /api/v3 root), e.g. https://api.masteringbackend.com/api/v3.
# Public endpoint, no key. Feeds the Learners stat on the MasteringBackend card.
MB_API_URL=

# ---- DEV ONLY: never set in production ----
# 1 = preview with fake sample data
SNAPSHOT_SAMPLE=
# 1 = render the real snapshot written by npm run snapshot:local (beats SNAPSHOT_SAMPLE)
SNAPSHOT_LOCAL=
